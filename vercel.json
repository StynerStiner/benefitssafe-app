{
  "build": {
    "env": {
      "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
      "NEXT_PRIVATE_SKIP_VALIDATION": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sentinel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/compliance",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/reports",
      "schedule": "0 7 * * 1"
    }
  ]
}
