# BenefitsSafe Environment Variables
# Copy this file to .env.local and fill in the values
# In production, ALL secrets go in AWS Secrets Manager — never in .env files on the server

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/benefitssafe

# ─── Authentication ─────────────────────────────────────────────────
# NextAuth v5 uses AUTH_SECRET (legacy: NEXTAUTH_SECRET — both are checked)
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=same-value-as-AUTH_SECRET
NEXTAUTH_URL=http://localhost:3002

# ─── Encryption ─────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — app refuses to start without it
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (256 bits for AES-256-GCM)
ENCRYPTION_KEY=

# ─── OAuth Providers ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Stripe ─────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REMOVED_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Webhook Secret — REQUIRED IN PRODUCTION
# Get from https://dashboard.stripe.com/webhooks after creating endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Billing webhook secret (separate endpoint for subscription events)
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe-billing
STRIPE_BILLING_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Card charge webhook secret (Stripe Issuing transaction events)
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe-charges
# Events: issuing_transaction.created
STRIPE_CHARGES_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Price IDs for BenefitsSafe subscription tiers
# Get from https://dashboard.stripe.com/products after creating recurring prices
STRIPE_PRICE_SEED=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CORE=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_NETWORK=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ENTERPRISE=price_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── AWS ────────────────────────────────────────────────────────────
# S3 bucket for document uploads (beneficiary docs, receipts, org files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET=benefitssafe-uploads

# ─── Email / Notifications ─────────────────────────────────────────
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@benefitssafe.com

# ─── AI / Compliance Assistant ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Redis (Rate Limiting + Caching) ───────────────────────────────
# Optional: app falls back to in-memory rate limiting if not set
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ─── Composio (Workflow Automations) ───────────────────────────────
# Optional: enables Gmail/Slack/Calendar/Sheets integrations for nonprofits
# Get from https://app.composio.dev > Settings > API Keys
# Free tier: 20,000 calls/month (~30 nonprofits)
COMPOSIO_API_KEY=

# ─── Monitoring ─────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ─── Feature Flags ─────────────────────────────────────────────────
ENABLE_DEMO_MODE=false
ENABLE_MOCK_STRIPE=false
