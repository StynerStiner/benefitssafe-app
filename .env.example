# BenefitsSafe Environment Variables
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/benefitssafe

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3002

# OAuth Providers (optional for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REMOVED_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Plaid (for bank account linking)
# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # Use 'sandbox' for testing, 'production' for live

# Email/Notifications
# For sending invites and notifications
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@benefitssafe.com

# AI/Compliance
# Claude API for compliance assistant
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Upstash Redis (serverless, works with Vercel and AWS)
# Get these from https://console.upstash.com after creating a Redis database
# Optional: app falls back to no-cache and in-memory rate limiting if not set
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Logging & Monitoring (optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# Feature Flags
ENABLE_DEMO_MODE=false
ENABLE_MOCK_STRIPE=false  # Use mock Stripe in dev
